<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <TextView
        android:id="@+id/tvRepeatTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ponovno dodavanje narudžbe"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/tvRepeatMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Želiš li dodati prošlu narudžbu u košaricu?"
        android:textSize="16sp"
        android:textColor="#444444" />

    <Button
        android:id="@+id/btnRepeatAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Dodaj"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="@android:color/black" />

    <Button
        android:id="@+id/btnRepeatCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Odustani"
        android:textAllCaps="false"
        android:textColor="@android:color/black"
        android:backgroundTint="#DDDDDD" />

</LinearLayout>